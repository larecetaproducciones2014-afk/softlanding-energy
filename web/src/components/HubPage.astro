---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Icon from './Icon.astro';
import Faq from './Faq.astro';
import CtaBand from './CtaBand.astro';
import LeadForm from './LeadForm.astro';
import { rubros, type RubroKey } from '../data/rubros';
import { landingsBy } from '../data/landings';
import { site, wa } from '../config/site';
interface Props { rubro: RubroKey; meta: string; intro: { t: string; d: string }; nota?: string }
const { rubro, meta, intro, nota } = Astro.props;
const r = rubros[rubro];
const ls = landingsBy(rubro);
const ind = rubro === 'industrial';
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: r.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: site.url },
    { '@type': 'ListItem', position: 2, name: r.nombre, item: `${site.url}/${rubro}/` } ] },
];
---
<Base title={`${r.nombre}: ${r.h1}`} description={meta} theme={r.theme} jsonLd={jsonLd} waMsg={r.waMsg}>
  <Hero image={r.imagen} h1={r.h1} sub={r.sub} crumbs={[{ label: 'Inicio', href: '/' }, { label: r.nombre }]}>
    <a class="btn btn-primary btn-lg" href="#contacto">{r.cta}</a>
    {ind
      ? <a class="btn btn-ghost-light btn-lg" href="/soluciones/">Ver soluciones</a>
      : <a class="btn btn-ghost-light btn-lg" href={`/calculadora/?rubro=${rubro}`}>Calcular mi consumo</a>}
  </Hero>

  <section class="sec">
    <div class="wrap split">
      <div><span class="eyebrow">{r.quien}</span><h2>{intro.t}</h2><p class="lead" style="margin-top:14px">{intro.d}</p>
        {nota && <p class="note" style="margin-top:20px">{nota}</p>}</div>
      <ul class="checks" style="font-size:1.05rem">{r.pasos.map((p) => <li><span><b>{p.t}.</b> {p.d}</span></li>)}</ul>
    </div>
  </section>

  <section class="sec sec-alt">
    <div class="wrap">
      <div class="head"><span class="eyebrow">{ind ? 'Sectores' : rubro === 'comercial' ? 'Tipos de negocio' : 'Soluciones'}</span><h2>Encuentra la solución para tu caso</h2></div>
      <div class="grid g3">
        {ls.map((l) => (
          <a class="card link" href={`/${rubro}/${l.slug}/`}>
            <div class="thumb"><Image src={l.imagenLista} alt="" widths={[360, 540, 720]} sizes="(min-width:900px) 360px, 100vw" quality={60} format="webp" loading="lazy" /></div>
            <div class="ico" style="margin-top:-34px;position:relative;margin-left:8px"><Icon name={l.icono} /></div>
            <h3>{l.nombre}</h3>
            <p>{l.sub}</p>
            <span class="more">Ver solución <Icon name="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="head"><span class="eyebrow">Proceso</span><h2>Cómo trabajamos contigo</h2></div>
      <div class="steps cols">{r.proceso.map((p) => <div class="step"><h3>{p.t}</h3><p>{p.d}</p></div>)}</div>
    </div>
  </section>

  <Faq items={r.faq} />

  <section class="sec sec-alt">
    <div class="wrap" style="max-width:820px">
      <LeadForm tipo={ind ? 'diagnostico' : 'contacto'} rubro={rubro} titulo={ind ? 'Solicita tu diagnóstico energético' : 'Cotiza tu sistema'} boton={ind ? 'Solicitar diagnóstico' : 'Quiero que me contacten'} />
    </div>
  </section>

  <CtaBand titulo="Hablemos de tu proyecto" texto="Te acompañamos desde la asesoría hasta la instalación y el monitoreo." waMsg={r.waMsg} />
</Base>
