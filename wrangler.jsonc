{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "softlanding-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "softlanding-energy.com", "custom_domain": true },
    { "pattern": "www.softlanding-energy.com", "custom_domain": true }
  ],
  "vars": {
    "SUPABASE_URL": "https://uogjqwirpyivevwhmerz.supabase.co",
    "TENANT_SLUG": "softlanding",
    "ALLOWED_ORIGINS": "https://softlanding-energy.com,https://www.softlanding-energy.com"
  },
  "workers_dev": false,
  "preview_urls": false
}
