{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "softlanding-web",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "softlanding-energy.com", "custom_domain": true },
    { "pattern": "www.softlanding-energy.com", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
